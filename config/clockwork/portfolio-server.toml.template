[[jobs]]
name = "tachometer-dashboard"
description = "Portfolio stoplight dashboard — serves gauge page at :5100"
scope = "user"
service_type = "simple"
working_directory = "__REPO_ROOT__"
exec_start = "__REPO_ROOT__/scripts/serve_tachometer.sh"
restart = "on-failure"
standard_output = "journal"
standard_error = "journal"
service_install_wanted_by = ["default.target"]
